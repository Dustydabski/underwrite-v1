# Copy to .env.local and fill in.

# Sign up free (no card mentioned, no approval queue, 50 free requests/mo) at
# https://developers.rentcast.io — property + tax + AVM + rent in one API.
RENTCAST_API_KEY=

# Sign up for a free trial at https://api.developer.attomdata.com/signup —
# key is under Account > Applications. Requires ATTOM's manual approval,
# which can take a while (open a support ticket if it's pending more than a
# few days) — RentCast above is the faster path to real data in the meantime.
ATTOM_API_KEY=

# Optional: only needed if you get your own SimplyRETS production credentials.
# Defaults to SimplyRETS's public demo sandbox (fake listings) if unset.
SIMPLYRETS_USER=
SIMPLYRETS_SECRET=

# Address-autocomplete dropdown on the search box. Sign up free (no credit
# card) at https://account.mapbox.com — your default public token is shown
# right on the account dashboard after signup. Without this the search box
# still works, it just won't show suggestions as you type.
# NEXT_PUBLIC_* is intentional: Mapbox "pk." tokens are meant to be public
# and used directly from the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cost protection for RentCast/ATTOM calls once this app has more than one
# user. Create a free Redis store: Vercel dashboard -> Storage -> Marketplace
# -> "Upstash for Redis" -> Connect to this project (env vars below are
# auto-injected when you do that, no need to fill them in by hand).
# WITHOUT these set, there is NO cap on real-provider spend or per-IP abuse —
# set this up before sharing the app publicly.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the default monthly call caps (see BudgetGuardedProvider
# in app/api/lookup/route.ts). Each RentCast lookup costs up to 3 calls, each
# ATTOM lookup up to 2 — defaults (45 / 90) are set safely under RentCast's
# free 50/mo. Only takes effect once the Redis vars above are set.
RENTCAST_MONTHLY_CAP=
ATTOM_MONTHLY_CAP=

# Optional: override the per-IP throttle (default 5 requests/hour). Only
# takes effect once the Redis vars above are set.
IP_RATE_LIMIT_PER_HOUR=

# Pick your own secret string (anything — a long random phrase works well).
# Visit /api/admin-login?key=<this value> once in your browser to set a
# cookie that exempts you from the per-IP throttle above. Keep it private;
# anyone with this value gets the same unlimited access.
ADMIN_ACCESS_KEY=
